{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "next-intl/server": ["./src/shims/next-intl-server.ts"],
      "next-intl": ["./src/shims/next-intl.tsx"]
    }
  },
  "include": ["**/*.d.ts", "**/*.ts", "**/*.tsx", "src/images/logos/*.*"],
  "exclude": ["node_modules"]
}
