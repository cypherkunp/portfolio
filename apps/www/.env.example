# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Feature flags (Vercel Flags)
# Managed in Vercel Dashboard → Project → Flags
# Pull secrets after linking: `vercel link && vercel env pull`
# -----------------------------------------------------------------------------
# FLAGS=               # Auto-set by Vercel when you create a flag
# FLAGS_SECRET=        # Used by Flags Explorer for session overrides

# Flag keys declared in src/flags.ts:
#   feature-apps-support
#   feature-app-music
#   feature-app-inspirations
#   feature-app-bookmarks
#   feature-app-photos
#   feature-app-package-analyzer

# -----------------------------------------------------------------------------
# npm registry (used by /api/npm for the Package Analyzer)
# Create a read-only Automation token at https://www.npmjs.com/settings/<user>/tokens
# In dev, the server also falls back to ~/.npmrc if NPM_TOKEN is unset.
# -----------------------------------------------------------------------------
NPM_TOKEN=
