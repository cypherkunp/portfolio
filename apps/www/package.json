{
  "name": "www",
  "description": "Personal website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3333",
    "build": "next build",
    "start": "next start -p 3333",
    "preview": "next build && next start -p 3333",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "analyze-build": "ANALYZE=true next build",
    "unlighthouse-ci": "unlighthouse-ci",
    "bookmarks:sync": "node scripts/bookmarks-sync.mjs",
    "bookmarks:fetch": "node scripts/fetch-bookmarks-og.mjs",
    "test": "vitest run && node --test scripts/lib/*.test.mjs",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@playwright/test": "^1.63.0",
    "@repo/utils": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@vitejs/plugin-react": "^5.2.0",
    "baseline-browser-mapping": "^2.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@flags-sdk/vercel": "^1.4.6",
    "@next/bundle-analyzer": "^16.1.6",
    "@repo/ui": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "client-only": "^0.0.1",
    "exifr": "^7.1.3",
    "flags": "^4.0.5",
    "fumadocs-core": "^16.6.12",
    "fumadocs-mdx": "^14.2.9",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.1",
    "next-intl": "^4.8.3",
    "reading-duration": "^1.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sugar-high": "^0.9.5",
    "tailwindcss": "^4.2.1",
    "zod": "^4.3.6"
  }
}
