{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalEnv": ["GITHUB_ACCESS_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "env": ["CI"],
      "passThroughEnv": ["PLAYWRIGHT_*"],
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "dev:tunnel": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "start": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
